# Copy to .env (gitignored) and fill in. Never commit the real file.
# Values mirror a typical mail app's account screen (K-9, Thunderbird, ...).

# --- Incoming server (IMAP) ---
IMAP_HOST=imap.example.com
IMAP_SECURITY=ssl            # ssl (SSL/TLS) | starttls | none
IMAP_PORT=993                # default: 993 for ssl, 143 otherwise
IMAP_AUTH=plain              # plain (normal password) | cram-md5
IMAP_USER=you@example.com
IMAP_PASSWORD=
# IMAP_CLIENT_CERT=          # path inside the container, e.g. /data/client.crt
# IMAP_CLIENT_KEY=           # path to the key, if separate from the cert
# IMAP_FOLDER=INBOX

# --- Outgoing server (SMTP) ---
SMTP_HOST=smtp.example.com   # defaults to IMAP_HOST
SMTP_SECURITY=ssl            # ssl | starttls | none
SMTP_PORT=465                # default: 465 for ssl, 587 for starttls, else 25
SMTP_AUTH=plain              # plain | cram-md5 | none
# SMTP_USER=                 # defaults to IMAP_USER
# SMTP_PASSWORD=             # defaults to IMAP_PASSWORD
# SMTP_CLIENT_CERT=
# SMTP_CLIENT_KEY=
# SMTP_FROM=                 # envelope sender, defaults to IMAP_USER

# --- Delivery ---
DEST_ADDRESS=you@proton.me

# --- Optional ---
# POLL_SECONDS=300
# START_FROM=2026-10-10      # first run only; default is yesterday
